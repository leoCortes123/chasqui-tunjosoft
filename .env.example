# =============================================================================
# Chasqui TunjoSoft — Variables de entorno
# -----------------------------------------------------------------------------
# Copie este archivo como .env y complete los valores:
#     cp .env.example .env
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).
# Después de cambiar algo aquí: docker compose up -d
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Zona horaria
# -----------------------------------------------------------------------------
# Todo el sistema almacena en UTC y presenta en hora local de Bogotá.
# No cambiar salvo que el negocio opere en otro huso horario.
TZ=America/Bogota


# -----------------------------------------------------------------------------
# 1b. Puertos en la máquina anfitriona
# -----------------------------------------------------------------------------
# En esta máquina conviven cuatro sistemas: Chasqui (5432/5678), Chasqui Pet
# (5433/5679), Chasqui Assistant (5434/5680) y este. Por eso los puertos de
# TunjoSoft están corridos un lugar más. Cámbielos sólo si chocan con algo más.
#
# ⚠️ Assistant está corriendo con el demo de un cliente a la espera. Cambiar
# estos puertos a los suyos lo tumba sin avisar.
PUERTO_DB=5435
PUERTO_N8N=5681
# Puerto de la pantalla pública y el portal. Éste SÍ se expone a la red local:
# es el del portal de administración.
PUERTO_WEB=3300
# Proxy público (Caddy). Sólo escucha en 127.0.0.1: hacia afuera se sale por el
# túnel, no por este puerto. Es el que atiende el webhook y el portal desde
# internet, bajo un mismo hostname.
PUERTO_PROXY=8083


# -----------------------------------------------------------------------------
# 1c. Perfiles de compose
# -----------------------------------------------------------------------------
# El perfil "local" agrega los dos servicios que hacen que el bot quede vivo
# solo: `cloudflared` (túnel HTTPS público, porque Telegram no entrega webhooks
# a una máquina sin dominio) y `registrador` (descubre la dirección del túnel en
# cada arranque, re-registra el webhook y actualiza config.portal_url).
#
# Dejarlo aquí es lo que hace que un simple `docker compose up -d` levante todo
# listo para hablar con el bot, sin tener que acordarse de `--profile local`.
# Con dominio propio: deje esto vacío y llene WEBHOOK_URL_FIJA.
COMPOSE_PROFILES=local


# -----------------------------------------------------------------------------
# 2. Base de datos de negocio (PostgreSQL 16)
# -----------------------------------------------------------------------------
# Usuario dueño de la base. Se crea automáticamente la primera vez que arranca
# el contenedor db (cuando el volumen pgdata está vacío).
POSTGRES_USER=chasqui_tunjosoft

# Contraseña del usuario anterior. Invéntela larga y aleatoria, por ejemplo con:
#     openssl rand -base64 24
POSTGRES_PASSWORD=cambie_esta_clave_por_una_aleatoria

# Nombre de la base de datos de negocio.
POSTGRES_DB=chasqui_tunjosoft

# Contraseña del rol de aplicación `chasqui_tunjosoft_app`. Es el rol con el que se
# conectan n8n, el worker y el portal. NO es dueño de las tablas y no puede
# hacer UPDATE ni DELETE sobre la auditoría ni sobre los movimientos de
# inventario: eso es lo que hace que el registro sea confiable.
#     openssl rand -base64 24
APP_DB_PASSWORD=cambie_esta_clave_de_aplicacion

# Contraseña del rol `chasqui_tunjosoft_lectura`, sólo lectura, para reportes externos.
# Puede dejarse vacía si no se va a usar.
READONLY_DB_PASSWORD=

# Cadena de conexión que usan el worker, la web y los nodos Postgres de n8n.
# El host es "db" porque es el nombre del servicio dentro de la red de Docker;
# desde su computador (fuera de Docker) sería localhost:${PUERTO_DB}.
# Usa chasqui_tunjosoft_app (no el usuario dueño) y su contraseña debe coincidir con
# APP_DB_PASSWORD.
DATABASE_URL=postgresql://chasqui_tunjosoft_app:cambie_esta_clave_de_aplicacion@db:5432/chasqui_tunjosoft

# Cadena de conexión administrativa, sólo para migraciones y mantenimiento.
ADMIN_DATABASE_URL=postgresql://chasqui_tunjosoft:cambie_esta_clave_por_una_aleatoria@db:5432/chasqui_tunjosoft


# -----------------------------------------------------------------------------
# 3. Base de datos propia de n8n
# -----------------------------------------------------------------------------
# n8n guarda sus workflows, credenciales y ejecuciones en una base SEPARADA,
# dentro del mismo servidor Postgres y con un usuario propio sin acceso a la
# base de negocio. La crea db/migrations/000_n8n_db.sh en el primer arranque.
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
# Genérela igual que la anterior: openssl rand -base64 24
N8N_DB_PASSWORD=cambie_esta_clave_de_n8n


# -----------------------------------------------------------------------------
# 4. n8n — acceso y webhooks
# -----------------------------------------------------------------------------
# Host con el que n8n se identifica a sí mismo. En local déjelo en localhost.
N8N_HOST=localhost

# URL pública que Telegram usará para entregar los webhooks del bot.
# En local, con Telegram, necesita un túnel (ngrok, cloudflared) porque Telegram
# tiene que poder alcanzar esta URL desde internet. Ejemplo:
#     WEBHOOK_URL=https://a1b2c3d4.ngrok-free.app/
# Debe terminar en barra (/).
#
# Con el perfil "local" levantado NO hay que mantenerla a mano: el servicio
# `registrador` descubre la dirección del túnel en cada arranque, re-registra el
# webhook y la escribe en config.portal_url, que es de donde el bot saca el
# enlace de ingreso al portal. Esta variable queda entonces como referencia
# para n8n; la fuente de verdad es la base.
WEBHOOK_URL=http://localhost:5681/

# Dominio propio, si algún día lo hay. Con esto lleno, el registrador deja de
# adivinar y usa esta dirección tal cual (y cloudflared sobra).
WEBHOOK_URL_FIJA=

# Usuario y contraseña para entrar al panel de n8n en http://localhost:5681
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambie_esta_clave_de_panel

# Clave con la que n8n cifra las credenciales que usted guarde en su panel.
# Genérela UNA sola vez con:  openssl rand -hex 32
# ATENCIÓN: si la cambia después, n8n no podrá descifrar las credenciales ya
# guardadas y habrá que volver a cargarlas a mano.
N8N_ENCRYPTION_KEY=cambie_esta_clave_por_64_caracteres_hexadecimales_aleatorios


# -----------------------------------------------------------------------------
# 5. Bot de Telegram
# -----------------------------------------------------------------------------
# Token del bot. Se obtiene hablando con @BotFather en Telegram:
#   1. Abra un chat con @BotFather
#   2. Envíe /newbot y siga las instrucciones (nombre y usuario del bot)
#   3. BotFather responde con un token con la forma 1234567890:AA...
# Este token da control TOTAL del bot: trátelo como una contraseña.
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre de usuario del bot, SIN la arroba. Es el que eligió en @BotFather y
# termina siempre en "bot". Se usa para armar los enlaces profundos del QR de
# del login web.
TELEGRAM_BOT_USERNAME=chasqui_tunjosoft_bot


# -----------------------------------------------------------------------------
# 5b. WhatsApp (Meta Cloud API) — listo para cuando exista el número
# -----------------------------------------------------------------------------
# Todo el camino de WhatsApp está construido: el enrutador en la base
# (db/migrations/145_canal_whatsapp.sql), el envío en el worker
# (worker/src/whatsapp.js) y el workflow n8n/workflows/02-whatsapp-webhook.json.
# Lo único que falta es el número aprobado por Meta.
#
# Mientras estas variables estén vacías, no pasa nada malo: el canal de
# WhatsApp queda inactivo, el worker responde `whatsapp_sin_configurar` y
# Telegram sigue funcionando igual. NO hay que comentar ni borrar nada.
#
# Cuando el número exista, en developers.facebook.com → su app → WhatsApp:
#   1. WHATSAPP_PHONE_NUMBER_ID: «Phone number ID» del número (NO el número).
#   2. WHATSAPP_TOKEN: token de acceso. El temporal dura 24 horas y sirve para
#      probar; para dejarlo vivo se genera uno permanente desde un usuario de
#      sistema en Business Manager.
#   3. WHATSAPP_VERIFY_TOKEN: se lo inventa usted. Meta se lo va a devolver
#      cuando registre el webhook, y el workflow compara. Cualquier cadena
#      larga sirve:  openssl rand -hex 16
#   4. Registrar el webhook apuntando a
#      https://<su-dominio>/webhook/chasqui-tunjosoft-whatsapp
#      y suscribirse al campo «messages».
#   5. Activar el workflow «Webhook de WhatsApp» en n8n. Nace desactivado a
#      propósito: un webhook a medio configurar recibe mensajes y los pierde.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Sólo si hay que fijar otra versión de la Graph API. Vacío = v21.0.
WHATSAPP_API_VERSION=


# -----------------------------------------------------------------------------
# 6. Superadministrador inicial
# -----------------------------------------------------------------------------
# Identificador numérico de Telegram de la persona que será superadmin.
# Para obtenerlo: abra Telegram, busque @userinfobot, presione Iniciar y él
# responde con su "Id" (un número, por ejemplo 123456789).
# OJO: es el user id de la PERSONA, no el del bot y no el nombre de usuario.
# Con este dato el seed de la base crea el primer usuario del sistema; nadie
# más puede autoregistrarse.
SUPERADMIN_TELEGRAM_USER_ID=123456789

# Nombre completo del superadmin, como debe aparecer en la auditoría y el portal.
SUPERADMIN_NOMBRE=Leonardo


# -----------------------------------------------------------------------------
# 7. Portal web
# -----------------------------------------------------------------------------
# URL con la que se abre el portal de administración.
# Use la IP LAN del equipo que corre Docker, por ejemplo:
#     WEB_PUBLIC_URL=http://192.168.1.50:3300
WEB_PUBLIC_URL=http://localhost:3300

# Secreto con el que se firman las cookies de sesión del portal.
# Genérelo con:  openssl rand -hex 32
# Si lo cambia, todas las sesiones abiertas se cierran (eso es lo esperado).
SESSION_SECRET=cambie_este_secreto_por_64_caracteres_hexadecimales_aleatorios


# -----------------------------------------------------------------------------
# 8. Worker de tareas asíncronas
# -----------------------------------------------------------------------------
# Cada cuántos milisegundos el worker revisa la tabla tarea_async.
WORKER_INTERVALO_MS=2000

# Cuántas tareas toma como máximo en cada pasada.
WORKER_LOTE=10


# -----------------------------------------------------------------------------
# 8b. «Habla con Chasqui» — el asistente en lenguaje natural del bot
# -----------------------------------------------------------------------------
# Llave de la API de DeepSeek, que es quien responde. Se saca de
# https://platform.deepseek.com → API keys. Empieza por sk-.
#
# Ojo con el saldo: DeepSeek es de prepago y cuando se acaba, deja de
# responder. El saldo se consulta con:
#     curl https://api.deepseek.com/user/balance -H "Authorization: Bearer $DEEPSEEK_API_KEY"
#
# Si se deja vacía, el botón «💬 Habla con Chasqui» sigue apareciendo pero
# responde que no está configurado; el resto del bot no se entera. Para
# apagarlo del todo, ponga la configuración `ia_activa` en false desde el
# portal y el botón desaparece.
#
# El modelo, la temperatura y cuánto recuerda la conversación NO se
# configuran aquí sino en la tabla `config` (claves ia_*), editables desde
# el portal: son decisiones de operación, no de despliegue.
DEEPSEEK_API_KEY=

# Sólo si se apunta a otro servidor compatible con la API de OpenAI.
# Vacío = https://api.deepseek.com
DEEPSEEK_BASE_URL=


# -----------------------------------------------------------------------------
# 9. Copias de seguridad
# -----------------------------------------------------------------------------
# Días que se conservan los respaldos antes de borrarse automáticamente.
BACKUP_RETENCION_DIAS=14

# Hora local de Bogotá a la que corre el respaldo diario, en formato HH:MM
# (24 horas). Elija una hora de madrugada.
BACKUP_HORA=02:30
